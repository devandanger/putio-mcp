# Copy to .env (which is gitignored) and fill in your put.io OAuth token.
# Get one at https://app.put.io/oauth -> Create App -> key icon -> Secrets.
PUTIO_TOKEN=paste-your-token-here

# Optional: bypass system / *_PROXY proxy settings if a configured proxy is down.
# PUTIO_MCP_IGNORE_PROXY=1

# Optional: DEBUG, INFO, WARNING, ERROR
# PUTIO_MCP_LOG_LEVEL=INFO
